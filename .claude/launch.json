{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "surveymind",
      "runtimeExecutable": "/opt/anaconda3/bin/python",
      "runtimeArgs": ["-m", "streamlit", "run", "app.py", "--server.port", "8599", "--server.headless", "true"],
      "port": 8599
    },
    {
      "name": "surveymind-api",
      "runtimeExecutable": "/opt/anaconda3/bin/python",
      "runtimeArgs": ["-m", "uvicorn", "backend.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "surveymind-frontend",
      "runtimeExecutable": "/opt/anaconda3/bin/python",
      "runtimeArgs": ["-m", "http.server", "5500", "-d", "frontend"],
      "port": 5500
    }
  ]
}
