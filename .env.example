# ============================================================
# SurveyMind · LLM API 配置模板
#
# 使用方法（key 绝不要提交到 git，.env 已在 .gitignore 中忽略）：
#   1. 复制本文件为 .env ：   cp .env.example .env
#   2. 在 .env 里填入你自己的 API key
#   3. 重启后端（uvicorn）/ Streamlit 后生效
# ============================================================

# ===== 默认：DeepSeek（https://platform.deepseek.com 注册并创建 key）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== 切换到 Anthropic Claude（OpenAI 兼容层）时，注释掉上面两行，改用：=====
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-sonnet-5
# 成本优先可改用：
# LLM_MODEL=claude-haiku-4-5-20251001

# 其他 OpenAI 兼容供应商（Kimi / 智谱 GLM / 通义等）同理：
# 只需替换 LLM_BASE_URL 与 LLM_MODEL，代码无需改动。
